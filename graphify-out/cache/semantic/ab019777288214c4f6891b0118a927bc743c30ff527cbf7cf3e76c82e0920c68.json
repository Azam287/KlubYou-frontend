{"nodes": [{"id": "index_klubyou_creator_dashboard", "label": "KlubYou Creator Dashboard (HTML shell)", "file_type": "document", "source_file": "index.html", "source_location": "index.html:1-19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_root", "label": "#root mount element", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_src_main_jsx_entry", "label": "/src/main.jsx module entry", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_spa_bootstrap_pattern", "label": "Single-page app bootstrap via ES module entry", "file_type": "rationale", "source_file": "index.html", "source_location": "index.html:15-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HTML body carries no markup other than an empty #root div and a type=module script pointing at /src/main.jsx. This is the Vite/React SPA convention: the browser loads a near-empty document, the bundler-served ES module takes over and renders the whole UI client-side. Trade-off accepted: no server-rendered content (weaker first paint and SEO) in exchange for a single client-owned render tree and native ESM dev serving with no build step during development."}, {"id": "index_google_fonts_typography", "label": "Google Fonts typography stack (Bricolage Grotesque + Hanken Grotesk)", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:8-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two remote font families are loaded from fonts.googleapis.com with preconnect hints to both googleapis and gstatic, and display=swap. Bricolage Grotesque is pulled as a variable optical-size display face at weights 500-800 (headings/brand), Hanken Grotesk at 400-700 as the reading face. The preconnect pair and swap are deliberate first-paint mitigations for the extra third-party round trip."}, {"id": "index_inline_svg_favicon", "label": "Inline data-URI SVG favicon (play glyph)", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The favicon is embedded as a data:image/svg+xml URI rather than a file asset: a rounded dark-purple square (#221A38) with an orange (#F15B41) play triangle. Avoids an extra network request and keeps the brand colors declared inline in the shell, at the cost of an unminified escaped-markup attribute. The play glyph signals a video/creator-media product, matching the 'Creator Dashboard' title."}, {"id": "index_creator_dashboard_product", "label": "Creator Dashboard product surface", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_mobile_responsive_viewport", "label": "Mobile-responsive viewport declaration", "file_type": "concept", "source_file": "index.html", "source_location": "index.html:6", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "index_klubyou_creator_dashboard", "target": "index_root", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:16", "weight": 1.0}, {"source": "index_klubyou_creator_dashboard", "target": "index_src_main_jsx_entry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:17", "weight": 1.0}, {"source": "index_klubyou_creator_dashboard", "target": "index_google_fonts_typography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:8-13", "weight": 1.0}, {"source": "index_klubyou_creator_dashboard", "target": "index_inline_svg_favicon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:5", "weight": 1.0}, {"source": "index_klubyou_creator_dashboard", "target": "index_mobile_responsive_viewport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:6", "weight": 1.0}, {"source": "index_klubyou_creator_dashboard", "target": "index_creator_dashboard_product", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "index.html:7", "weight": 1.0}, {"source": "index_src_main_jsx_entry", "target": "index_root", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "index.html", "source_location": "index.html:16-17", "weight": 1.0}, {"source": "index_spa_bootstrap_pattern", "target": "index_klubyou_creator_dashboard", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "index.html", "source_location": "index.html:15-18", "weight": 1.0}, {"source": "index_spa_bootstrap_pattern", "target": "index_src_main_jsx_entry", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "index.html", "source_location": "index.html:17", "weight": 1.0}, {"source": "index_inline_svg_favicon", "target": "index_creator_dashboard_product", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "index.html", "source_location": "index.html:5-7", "weight": 1.0}, {"source": "index_google_fonts_typography", "target": "index_inline_svg_favicon", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score